{
  "name": "git-devel",
  "main": "server/src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NODE_ENV": "production"
  },
  "r2_buckets": [
    {
      "binding": "bucket",
      "bucket_name": "gitdevel"
    }
  ],
  "d1_databases": [
    {
      "binding": "database",
      "database_name": "git-devel"
    }
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ]
}
