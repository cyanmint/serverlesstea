{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/vite-env.d.ts",
    "src/pages-generated/home.tsx",
    "src/pages-generated/install.tsx",
    "src/pages-generated/explore/repos.tsx",
    "src/pages-generated/explore/users.tsx",
    "src/pages-generated/repo/commits.tsx",
    "src/pages-generated/repo/view_file.tsx",
    "src/pages-generated/repo/home.tsx",
    "src/pages-generated/user/profile.tsx"
  ]
}
